# 自訂資料源（BYO Server）設定
# 複製成 .env 後填寫：cp .env.example .env
# .env 已在 .gitignore 裡 —— 不要提交它。

# 資料庫密碼（任意長字串，建議 openssl rand -hex 20）
BYO_DB_PASSWORD=

# FinMind API token —— 這台要抓的資料主要來自這裡
# 免費方案有每日配額，首次補三年歷史會分好幾天完成（會自動接續，不必管它）
BYO_FINMIND_TOKEN=

# 要補多少天的歷史（預設 1095 = 三年）
# 回測需要足夠長的區間才有統計意義；只想試跑可以先設 90
BACKFILL_DAYS=1095

# ── 以下只有用 docker-compose.proxy.yml（nginx-proxy + Let's Encrypt）時需要 ──
# 對外網址。⚠️ 不能填 Investa 的網址
BYO_HOST=
# Let's Encrypt 通知信箱
BYO_EMAIL=

# ── 獨立部署（不走 proxy）時用 ──
# 對外開的 port
BYO_PORT=8088
# 允許的來源，逗號分隔；預設 * 。安全性靠 X-API-Key 標頭，不靠來源限制
BYO_ALLOWED_ORIGINS=*
